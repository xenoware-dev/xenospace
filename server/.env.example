NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/xenospace

# Generate strong random values, e.g: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-random-64-char-hex-string
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

BCRYPT_SALT_ROUNDS=12

# Optional: leave blank in development to log emails to the console instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Xenospace <no-reply@xenoware.dev>"

# File library: where uploaded bytes are written (relative paths resolve from server/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=10
