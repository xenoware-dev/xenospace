{
  "name": "@xenospace/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@node-rs/argon2": "2.0.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@xenospace/shared": "1.0.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "multer": "2.4.0",
    "nanoid": "5.1.16",
    "otplib": "12.0.1",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "socket.io": "4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.19.0",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "pino-pretty": "13.0.0",
    "supertest": "7.0.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
