# XenoSpace API configuration. Copy to `.env` and fill in.
# Every value has a development default; production refuses to boot without the
# ones marked REQUIRED IN PRODUCTION.

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# --- Database (Supabase) -----------------------------------------------------
# REQUIRED IN PRODUCTION. Supabase → Project Settings → Database → Connection
# string → URI. Use the *session* pooler (port 5432) for this long-running
# server; the transaction pooler (6543) does not support the transactions the
# API relies on. Leave unset locally to use the built-in PGlite database.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Team lead ---------------------------------------------------------------
# Comma-separated emails that are the team leads — and the only ones. Everyone
# else is a developer and nobody else can be promoted. The address gets the
# role only through Google sign-in (or an invitation), which proves the inbox.
# Unset, the first account to register becomes the lead: fine for a fresh
# local install, risky anywhere a stranger could register first.
# ADMIN_EMAILS=lead@example.com

# Who can get in. `invite_only`: only addresses a team lead adds (Team
# Members → Add a member) or ADMIN_EMAILS; everyone else is turned away.
# `open`: anyone can register. PASSWORD_LOGIN=false makes Google the only way
# to sign in, which needs GOOGLE_CLIENT_ID/SECRET below.
# ACCESS=invite_only
# PASSWORD_LOGIN=false

# --- Redis ------------------------------------------------------------------
# REQUIRED IN PRODUCTION: shared rate limits and multi-instance realtime.
# REDIS_URL=redis://localhost:6379

# --- Secrets ----------------------------------------------------------------
# REQUIRED IN PRODUCTION, and each must be different. Generate each with:
#   openssl rand -hex 32
# Set them locally too, or every restart signs everyone out.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=

# --- Cookies ----------------------------------------------------------------
# `false` only for plain-HTTP local development.
COOKIE_SECURE=false
# `lax` whenever web and API share a registrable domain (app.x.com + api.x.com).
# `none` only for a truly cross-site setup, and it requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- Google sign-in (optional) ----------------------------------------------
# Authorised redirect URI to register with Google:
#   ${API_URL}/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- File storage (optional) ------------------------------------------------
# Without these, uploads go to ./.uploads on local disk.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=xenospace

# Exact number of proxy hops in front of the API, or `loopback`. Wrong values
# let clients spoof their IP and dodge rate limits.
TRUST_PROXY=loopback
LOG_LEVEL=info
