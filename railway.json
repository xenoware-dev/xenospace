{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@xenospace/api"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@xenospace/api",
    "preDeployCommand": ["npm run db:migrate:prod --workspace=@xenospace/api"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
